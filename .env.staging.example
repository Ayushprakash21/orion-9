# ==============================================================================
# ORION-9 STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env.staging' (or '.env.staging.local') in the project root.
# 2. Populate with dedicated staging credentials for the 'orion-9-staging' project.
# 3. DO NOT commit '.env.staging' to Git repository (enforced by .gitignore).
# 4. Note: Using production ('orion9-dev-db-2026') credentials will fail closed at build.
# ==============================================================================

# Target Environment & Gateway
APP_URL="https://orion-9-staging.workers.dev"

# Dedicated Staging Firebase Project Configuration
VITE_FIREBASE_API_KEY="YOUR_STAGING_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="orion-9-staging.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="orion-9-staging"
VITE_FIREBASE_STORAGE_BUCKET="orion-9-staging.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_STAGING_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_STAGING_FIREBASE_APP_ID"

# Explicit Multi-Tenant Staging Isolation Keys (used by firebaseClient.ts)
VITE_STAGING_FIREBASE_API_KEY="YOUR_STAGING_FIREBASE_API_KEY"
VITE_STAGING_FIREBASE_AUTH_DOMAIN="orion-9-staging.firebaseapp.com"
VITE_STAGING_FIREBASE_PROJECT_ID="orion-9-staging"
VITE_STAGING_FIREBASE_STORAGE_BUCKET="orion-9-staging.firebasestorage.app"
VITE_STAGING_FIREBASE_MESSAGING_SENDER_ID="YOUR_STAGING_MESSAGING_SENDER_ID"
VITE_STAGING_FIREBASE_APP_ID="YOUR_STAGING_FIREBASE_APP_ID"
