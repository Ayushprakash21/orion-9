rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security enforcement
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOrgMember(orgId) {
      return isAuthenticated() && (
        (request.auth.token != null && request.auth.token.organizationId == orgId) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().organizationId == orgId ||
          getUserData().tenantId == orgId
        ))
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token != null && request.auth.token.role in ['platform_admin', 'organization_admin', 'admin']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          getUserData().role in ['platform_admin', 'organization_admin', 'admin'])
      );
    }

    // Default deny for all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profiles collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isOrgMember(resource.data.organizationId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // Organizations & Tenant configuration (Admin managed)
    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId) || isAdmin();
      allow write: if isAdmin();
    }

    // Purchase Orders collection (Tenant isolated)
    match /purchase_orders/{poId} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.organizationId) || isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && isOrgMember(request.resource.data.organizationId);
      allow update: if isAuthenticated() && (isOrgMember(resource.data.organizationId) || isAdmin());
      allow delete: if isAdmin();
    }

    // Inventory collection
    match /inventory/{itemId} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.organizationId) || isAdmin());
      allow create, update: if isAuthenticated() && isOrgMember(request.resource.data.organizationId);
      allow delete: if isAdmin();
    }

    // Suppliers collection
    match /suppliers/{supplierId} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.organizationId) || isAdmin());
      allow create, update: if isAuthenticated() && isOrgMember(request.resource.data.organizationId);
      allow delete: if isAdmin();
    }

    // Shipments collection
    match /shipments/{shipmentId} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.organizationId) || isAdmin());
      allow create, update: if isAuthenticated() && isOrgMember(request.resource.data.organizationId);
      allow delete: if isAdmin();
    }

    // Approvals Engine collection (Strict approver / admin update)
    match /approvals/{approvalId} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.organizationId) || isAdmin());
      allow create: if isAuthenticated() && isOrgMember(request.resource.data.organizationId);
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (request.resource.data.status in ['APPROVED', 'REJECTED'] && request.auth.uid in resource.data.requiredApprovers)
      );
      allow delete: if isAdmin();
    }

    // Idempotency collection
    match /idempotency/{key} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Event Fabric collection
    match /events/{eventId} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.organizationId) || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Governance & Business Policies (Admin managed)
    match /policies/{policyId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Audit Logs collection (Read-only for org members, append-only for kernel, no client edits)
    match /audit_logs/{auditId} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.organizationId) || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if false; // Audit records are immutable once written
    }

    // System Administration & Integration Secrets (Platform Admin ONLY)
    match /administration/{docId} {
      allow read, write: if isAdmin();
    }

    match /integrations/{docId} {
      allow read, write: if isAdmin();
    }

    match /ai_governance/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Wave 3.3 Enterprise Integration Fabric collections
    match /transports/{transportId} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow write: if isAdmin();
    }

    match /trading_partners/{partnerId} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /integration_messages/{messageId} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && isOrgMember(request.resource.data.tenantId);
      allow update: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /integration_incidents/{incidentId} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /integration_schedules/{scheduleId} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow write: if isAdmin();
    }

    // Wave 4 Enterprise SCM Transaction Lifecycle collections
    match /supplier_qualifications/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /purchase_requisitions/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /rfqs/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /quotations/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /bid_evaluations/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /negotiations/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /supplier_awards/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /supplier_confirmations/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /asns/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /gate_entries/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /receipts/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /grns/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /quality_inspections/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /putaways/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /invoices/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /invoice_matches/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /payment_handoffs/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /supplier_performance/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow write: if isAdmin();
    }

    // ==========================================
    // WAVE 5 — AI AGENT GOVERNANCE COLLECTIONS
    // ==========================================

    match /agents/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow write: if isAdmin();
    }

    match /agent_tools/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /agent_memory/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /ai_decisions/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /ai_actions/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /ai_outcomes/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /ai_approvals/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    // ========================================================================
    // WAVE 6 — CONTROL TOWER INTELLIGENCE & DECISION ENGINE COLLECTIONS
    // ========================================================================

    match /signals/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /exceptions/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /root_causes/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /risk_nodes/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /risk_edges/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /predictions/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /decisions/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /decision_options/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /recommendations/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /decision_replays/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update, delete: if false; // Replays are immutable historical records
    }

    match /decision_outcomes/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update, delete: if false; // Outcome records are append-only
    }

    // =========================================================================
    // Wave 7 Autonomous Operations & Workflow Orchestration Collections
    // Strict tenant isolation and immutability rules
    // =========================================================================

    match /workflow_definitions/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /workflow_versions/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAdmin();
      allow update, delete: if false; // Versions are immutable snapshots
    }

    match /workflow_instances/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /workflow_steps/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /workflow_actions/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /workflow_approvals/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /workflow_executions/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update, delete: if false; // Execution records are immutable append-only
    }

    match /workflow_retries/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /workflow_compensations/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /workflow_schedules/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // =========================================================================
    // Wave 8 Enterprise Digital Twin & Scenario Simulation Collections
    // Strict tenant isolation and immutability rules
    // =========================================================================

    match /digital_twins/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /twin_snapshots/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update, delete: if false; // Snapshots are permanently immutable
    }

    match /twin_events/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update, delete: if false; // Twin events are immutable append-only
    }

    match /twin_relationships/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /twin_reconciliation/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update, delete: if false; // Reconciliation discrepancies are immutable audit records
    }

    match /scenarios/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /scenario_runs/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update, delete: if false; // Simulation runs are immutable audit logs
    }

    match /scenario_results/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update, delete: if false; // Simulation results are permanently immutable
    }

    match /scenario_assumptions/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /scenario_outcomes/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update, delete: if false; // Outcome tracking is append-only
    }

    // =========================================================================
    // Wave 9 Closed-Loop Outcome Intelligence & Enterprise Learning Collections
    // Strict tenant isolation and immutability rules
    // =========================================================================

    match /outcomes/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update, delete: if false; // Evaluated outcomes are permanently immutable
    }

    match /outcome_observations/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update, delete: if false; // Raw external observations are permanently immutable
    }

    match /outcome_variances/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update, delete: if false; // Computed variances are permanently immutable
    }

    match /outcome_attributions/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update: if isAuthenticated() && (isAdmin() || (isOrgMember(resource.data.tenantId) && request.resource.data.confidence == 'CONFIRMED_ROOT_CAUSE'));
      allow delete: if false;
    }

    match /learning_signals/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /improvement_proposals/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (isOrgMember(resource.data.tenantId) && request.resource.data.status in ['DRAFT', 'SIMULATED'])
      );
      allow delete: if isAdmin();
    }

    match /intelligence_versions/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update, delete: if isAdmin(); // Versions can only be promoted or rolled back by Admin
    }

    match /intelligence_experiments/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /intelligence_metrics/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update, delete: if false;
    }

    match /drift_signals/{id} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && (isOrgMember(request.resource.data.tenantId) || isAdmin());
      allow update, delete: if false; // Drift telemetry is append-only audit trail
    }
  }
}



