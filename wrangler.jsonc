{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orion-9",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-21",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "queues": {
    "producers": [
      {
        "binding": "SCM_EVENTS",
        "queue": "orion-scm-events"
      },
      {
        "binding": "SCM_EVENTS_DLQ",
        "queue": "orion-scm-events-dlq"
      }
    ],
    "consumers": [
      {
        "queue": "orion-scm-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "orion-scm-events-dlq",
        "retry_delay": 30
      }
    ]
  }
}
